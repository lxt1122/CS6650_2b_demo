{
  "info": {
    "name": "HW5 Product API",
    "description": "Triggers every response code defined for the Product endpoints in api.yaml. Set the baseUrl collection variable to http://localhost:8080 for local runs, or to http://<ECS public IP>:8080 after deploying.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) {",
          "    pm.test(\"error body matches Error schema\", () => {",
          "        const body = pm.response.json();",
          "        pm.expect(body.error).to.be.a(\"string\");",
          "        pm.expect(body.message).to.be.a(\"string\");",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "GET /products/{productId}",
      "item": [
        {
          "name": "GET 200 - existing product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"body is the requested product\", () => {",
                  "    const p = pm.response.json();",
                  "    pm.expect(p.product_id).to.eql(1);",
                  "    pm.expect(p).to.have.all.keys(\"product_id\", \"sku\", \"manufacturer\", \"category_id\", \"weight\", \"some_other_id\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            }
          }
        },
        {
          "name": "GET 404 - product not found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status is 404\", () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/99999",
              "host": ["{{baseUrl}}"],
              "path": ["products", "99999"]
            }
          }
        },
        {
          "name": "GET 404 - non-numeric ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status is 404\", () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/abc",
              "host": ["{{baseUrl}}"],
              "path": ["products", "abc"]
            }
          }
        },
        {
          "name": "GET 500 - simulated error",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status is 500\", () => pm.response.to.have.status(500));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Simulate-Error", "value": "true" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "POST /products/{productId}/details",
      "item": [
        {
          "name": "POST 204 - valid details",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));",
                  "pm.test(\"body is empty\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 2,\n  \"sku\": \"ABC-123-XYZ\",\n  \"manufacturer\": \"Acme Corporation\",\n  \"category_id\": 456,\n  \"weight\": 1250,\n  \"some_other_id\": 789\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products/2/details",
              "host": ["{{baseUrl}}"],
              "path": ["products", "2", "details"]
            }
          }
        },
        {
          "name": "GET 200 - update persisted",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"product 2 has the details from the previous POST\", () => {",
                  "    const p = pm.response.json();",
                  "    pm.expect(p.sku).to.eql(\"ABC-123-XYZ\");",
                  "    pm.expect(p.weight).to.eql(1250);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/2",
              "host": ["{{baseUrl}}"],
              "path": ["products", "2"]
            }
          }
        },
        {
          "name": "POST 204 - weight 0 is valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status is 204\", () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 3,\n  \"sku\": \"FEATHER-001\",\n  \"manufacturer\": \"Acme Corporation\",\n  \"category_id\": 1,\n  \"weight\": 0,\n  \"some_other_id\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products/3/details",
              "host": ["{{baseUrl}}"],
              "path": ["products", "3", "details"]
            }
          }
        },
        {
          "name": "POST 400 - missing required field",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status is 400\", () => pm.response.to.have.status(400));"]
